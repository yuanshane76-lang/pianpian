{
  "name": "zhiyan-workbench",
  "productName": "篇篇",
  "version": "0.3.0",
  "private": true,
  "description": "篇篇：你的 AI 论文阅读伙伴。每篇论文，都有个伴。",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:pdf-worker": "node scripts/copy-pdf-worker.cjs",
    "predev": "npm run prepare:pdf-worker",
    "prebuild": "npm run prepare:pdf-worker",
    "desktop:dev": "concurrently -k -s first \"npm:dev\" \"npm:desktop:electron\"",
    "desktop:electron": "wait-on http://127.0.0.1:4173 && electron .",
    "build": "tsc --noEmit && vite build",
    "make:win": "npm run check && electron-forge make --platform=win32 --arch=x64",
    "test": "vitest",
    "test:watch": "vitest",
    "test:paragraph-vocabulary:e2e": "npm run build && node scripts/paragraph-vocabulary-e2e.cjs",
    "test:research-agent:e2e": "npm run build && node scripts/research-agent-e2e.cjs",
    "test:pi-agent:smoke": "node scripts/pi-agent-smoke.cjs",
    "test:reader-performance:e2e": "npm run build && node scripts/reader-performance-e2e.cjs",
    "test:library-viewport:e2e": "npm run build && node scripts/library-viewport-e2e.cjs",
    "check:credentials": "node scripts/check-credentials.cjs",
    "check": "npm run check:credentials && npm run prepare:pdf-worker && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "partial-json": "^0.1.7",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.5.1",
    "jsdom": "^25.0.1",
    "playwright": "1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
